{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "celery worker",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "celery",
        "-A",
        "app.http.app:celery",
        "worker",
        "--loglevel=INFO",
        "--pool=solo"
      ],
      "options": {
        "cwd": "${workspaceFolder}/llmops-api"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "db migrate",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "flask",
        "--app",
        "app.http.app:create_app",
        "db",
        "migrate",
        "-m",
        "${input:migrationMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/llmops-api"
      },
      "problemMatcher": []
    },
    {
      "label": "db upgrade",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "flask",
        "--app",
        "app.http.app:create_app",
        "db",
        "upgrade"
      ],
      "options": {
        "cwd": "${workspaceFolder}/llmops-api"
      },
      "problemMatcher": []
    },
    {
      "label": "db downgrade",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "flask",
        "--app",
        "app.http.app:create_app",
        "db",
        "downgrade",
        "${input:downgradeRevision}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/llmops-api"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationMessage",
      "type": "promptString",
      "description": "Migration message"
    },
    {
      "id": "downgradeRevision",
      "type": "promptString",
      "description": "Target revision (for example: -1)",
      "default": "-1"
    }
  ]
}
