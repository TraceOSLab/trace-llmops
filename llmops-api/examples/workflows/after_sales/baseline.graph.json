      ],
      "code": "def main(params):\n    import json\n    data = json.loads(params['text'])\n    if data.get('ok') is not True or data.get('category') != 'standard':\n        raise ValueError('售后规则API返回无效结果')\n    window = data['return_window_days']\n    if type(window) is not int or not 1 <= window <= 30:\n        raise ValueError('退货期限异常')\n    return {'policy_text':data['rule'][:200], 'window_days':window}"
    },
