      ],
      "code": "def main(params):\n    query = params['query'].strip()\n    order_id = params['order_id'].strip().upper()\n    category = params.get('category', '').strip() or 'standard'\n    if not query or len(query) > 500 or not order_id or len(order_id) > 40 or len(category) > 40:\n        raise ValueError('query需要1至500字符，order_id需要1至40字符，category最多40字符')\n    return {'query': query, 'order_id': order_id, 'category': category}"
    },
