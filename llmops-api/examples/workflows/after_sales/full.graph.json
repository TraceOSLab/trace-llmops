      "code": "def main(params):\n    eligible = params['order_found'] and params['order_status'] == 'delivered' and 0 <= params['days'] <= params['window_days']\n    decision = 'return_eligible' if eligible else 'manual_review'\n    if not params['order_found']:\n        decision = 'order_not_found'\n    return {'decision':decision, 'eligible':eligible}"
