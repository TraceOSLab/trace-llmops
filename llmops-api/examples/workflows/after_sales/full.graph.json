      ],
      "code": "def main(params):\n    import json\n    data = json.loads(params['text'])\n    status = params['status_code']\n    if status == 404 and data.get('error') == 'order_not_found':\n        return {'order_status':'not_found','order_found':False,'days':0,'amount':0.0,'http_status':status}\n    if status != 200 or data.get('ok') is not True:\n        raise ValueError('订单服务响应异常')\n    return {'order_status':data['status'],'order_found':True,'days':int(data['days_since_delivery']),\n            'amount':float(data['amount']),'http_status':status}"
    },
