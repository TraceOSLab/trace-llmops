      ],
      "code": "def main(params):\n    import math\n    product = params['product'].strip()\n    quantity = params['quantity']\n    price = params['unit_price']\n    if not product or quantity <= 0 or not math.isfinite(price) or price < 0:\n        raise ValueError('商品名不能为空，数量必须为正数，单价必须为非负有限数')\n    subtotal = round(quantity * price, 2)\n    discount = 0.9 if params['vip'] else 1.0\n    return {'product':product, 'note':params['note'].strip() or '无备注', 'subtotal':subtotal, 'discount':discount, 'total':round(subtotal * discount, 2)}"
    },
