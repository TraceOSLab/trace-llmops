      "code": "def main(params):\n    import json\n    if params['status_code'] != 200:\n        raise ValueError('HTTP响应不是200')\n    data = json.loads(params['text'])\n    if not isinstance(data, list) or len(data) != 1:\n        raise ValueError('预期仅返回一条待办')\n    task = data[0]\n    if task['id'] != params['todo_id'] or not isinstance(task['title'], str) or type(task['completed']) is not bool:\n        raise ValueError('接口字段或ID不匹配')\n    return {'task_id':task['id'], 'title':task['title'], 'completed':task['completed'], 'response_chars':len(params['text'])}"
    },
