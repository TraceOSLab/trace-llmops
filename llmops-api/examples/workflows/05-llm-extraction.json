      "code": "def main(params):\n    import json\n    try:\n        data = json.loads(params['raw'])\n    except (ValueError, TypeError):\n        return {'name':'','email':'','format_valid':False,'validation_error':'不是合法JSON'}\n    valid = isinstance(data, dict) and set(data) == {'name','email'} and isinstance(data['name'], str) and isinstance(data['email'], str)\n    if not valid:\n        return {'name':'','email':'','format_valid':False,'validation_error':'字段或类型错误'}\n    return {'name':data['name'],'email':data['email'],'format_valid':True,'validation_error':''}"
