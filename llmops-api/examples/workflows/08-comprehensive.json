      ],
      "code": "def main(params):\n    import json\n    try:\n        data = json.loads(params['raw'])\n    except (ValueError, TypeError):\n        return {'answer': '', 'passed': False, 'validation_error': '模型未返回合法JSON'}\n    valid = isinstance(data, dict) and set(data) == {'answer', 'task_id', 'completed'}\n    valid = valid and isinstance(data['answer'], str) and 1 <= len(data['answer'].strip()) <= 600\n    valid = valid and type(data['task_id']) is int and data['task_id'] == params['task_id']\n    valid = valid and type(data['completed']) is bool and data['completed'] == params['completed']\n    if not valid:\n        return {'answer': '', 'passed': False, 'validation_error': '模型字段、答复长度或任务状态不符合约定'}\n    return {'answer': data['answer'], 'passed': True, 'validation_error': ''}"
    },
