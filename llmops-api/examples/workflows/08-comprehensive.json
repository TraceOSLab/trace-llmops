      "code": "def main(params):\n    import json\n    if params['status_code'] != 200:\n        raise ValueError('HTTP请求失败')\n    data = json.loads(params['text'])\n    if not isinstance(data, dict) or type(data.get('id')) is not int or not isinstance(data.get('title'), str) or type(data.get('completed')) is not bool:\n        raise ValueError('待办接口返回结构错误')\n    return {'task_id': data['id'], 'task_title': data['title'][:200], 'completed': data['completed']}"
    },
